# ═══════════════════════════════════════════════════════
# SniperBot — Environment Configuration
# ═══════════════════════════════════════════════════════
#
# SEMUA BISA DIISI OLEH USER VIA DASHBOARD (Settings > GMGN API)
# .env hanya sebagai fallback server — tidak wajib diisi.
#
# Cara pakai: cukup isi PORT aja, sisanya user set lewat web UI.
# ═══════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# DASHBOARD_PASSWORD=opsional

# ─── GMGN API (fallback — user bisa set sendiri) ──────
# GMGN_API_KEY=
# GMGN_PRIVATE_KEY=""

# ─── Telegram API (fallback — user isi saat login) ────
# Dapatkan dari https://my.telegram.org/apps
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# ─── Data Directory (untuk Render / Docker) ──────────
# DATA_DIR=/data
